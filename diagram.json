{
  "version": 1,
  "author": "ESP32 Room Monitor",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -105, "left": -130, "attrs": { "temperature": "26", "humidity": "45" } },
    { "type": "board-ssd1306", "id": "oled1", "top": -95, "left": 150, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-led", "id": "ledG", "top": 40, "left": 230, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "ledR", "top": 40, "left": 280, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 120, "left": 220, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 120, "left": 270, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 170, "left": 200, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 250, "left": 200, "attrs": { "color": "blue" } },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": 150, "left": -170, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:GND", "esp:GND.1", "black", [] ],
    [ "dht1:SDA", "esp:15", "green", [] ],

    [ "oled1:VCC", "esp:3V3", "red", [] ],
    [ "oled1:GND", "esp:GND.2", "black", [] ],
    [ "oled1:SDA", "esp:21", "blue", [] ],
    [ "oled1:SCL", "esp:22", "purple", [] ],

    [ "esp:2", "r1:1", "green", [] ],
    [ "r1:2", "ledG:A", "green", [] ],
    [ "ledG:C", "esp:GND.2", "black", [] ],

    [ "esp:4", "r2:1", "orange", [] ],
    [ "r2:2", "ledR:A", "orange", [] ],
    [ "ledR:C", "esp:GND.2", "black", [] ],

    [ "bz1:2", "esp:18", "gold", [] ],
    [ "bz1:1", "esp:GND.2", "black", [] ],

    [ "btn1:1.l", "esp:19", "blue", [] ],
    [ "btn1:2.l", "esp:GND.2", "black", [] ],

    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:SIG", "esp:34", "violet", [] ]
  ],
  "dependencies": {}
}
